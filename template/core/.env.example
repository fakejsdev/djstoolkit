# Discord Application ID — from the Discord Developer Portal (General Information tab)
# Used when registering/deploying slash commands.
DISCORD_APP_ID=<your-app-id-goes-here>

# Bot token — from the Developer Portal (Bot tab). Keep this secret, never commit it.
DISCORD_BOT_TOKEN=<your-bot-token-goes-here>

# Optional: Discord server (guild) ID for local development.
# When set, slash commands are registered ONLY to this guild — propagates instantly.
# When unset (e.g. in production), commands are registered globally — visible on every
# server the bot is in, but takes up to 1 hour (usually much quicker) to propagate after changes.
DEV_GUILD_ID=<your-guild-id-goes-here>